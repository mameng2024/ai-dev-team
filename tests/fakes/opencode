#!/usr/bin/env python3
"""Fake OpenCode CLI for tests. Mimics `opencode --version`, `run --help`, `models`, `run`.

FAKE_OC_PLAN: JSON {task_id: [attempt1, attempt2, ...]}, each attempt
  {"files": {path: content}, "delete": [paths], "sleep": seconds, "exit": code}
FAKE_OC_LOG: append one JSON line per run (argv, cwd, model, task, attempt, key present)
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("2.0.99-fake"); sys.exit(0)
if args[:1] == ["models"]:
    print("deepseek/deepseek-v4-flash\ndeepseek/deepseek-v4-pro"); sys.exit(0)
if args[:2] == ["run", "--help"]:
    print("opencode run [message]\n  --model  --agent  --continue  --session  --format\n"
          "  --file  --auto  --archived  --standalone  --server"); sys.exit(0)
if args[:1] != ["run"]:
    sys.exit(2)
prompt = args[-1]
model = args[args.index("--model") + 1] if "--model" in args else None
task = re.search(r"Task ID: (\S+)", prompt).group(1)
state = Path(os.environ["FAKE_OC_STATE"]); state.mkdir(parents=True, exist_ok=True)
counter = state / (re.sub(r"[^A-Za-z0-9]", "_", task) + ".n")
n = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(n + 1))
plan = json.loads(Path(os.environ["FAKE_OC_PLAN"]).read_text()).get(task, [{}])
step = plan[min(n, len(plan) - 1)]
with open(os.environ["FAKE_OC_LOG"], "a") as f:
    f.write(json.dumps({"argv": args[:-1], "cwd": os.getcwd(), "model": model, "task": task,
                        "attempt": n + 1, "has_key": bool(os.environ.get("DEEPSEEK_API_KEY")),
                        "fixes_in_prompt": "Required fixes" in prompt,
                        "t": time.time()}) + "\n")
if step.get("spawn_child"):
    subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
time.sleep(step.get("sleep", 0))
for rel, content in step.get("files", {}).items():
    p = Path(rel); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(content)
for rel in step.get("delete", []):
    Path(rel).unlink(missing_ok=True)
print(f"fake opencode did {task} attempt {n + 1}")
sys.exit(step.get("exit", 0))
