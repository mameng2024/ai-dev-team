# OpenCode must already be installed and authenticated separately.
OPENCODE_BIN=opencode

# Model registry (per-agent provider / model / fallbacks)
AI_DEV_TEAM_CONFIG=config/agents.yaml

# Cloud provider keys: prefer exporting them from your shell profile or Keychain.
# Do not put real keys in this file or commit them.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
